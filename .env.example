# ───────────────────────── Sherpa LM — environment ─────────────────────────
# Copy to .env (root) and apps/api/.env. Everything below has working dev
# defaults; nothing here requires a paid account to boot the platform.

NODE_ENV=development

# ── API ──
# Ports below avoid clashes with other services commonly running on this host
# (3000/5432/5173). Change freely if they are free for you.
API_PORT=3100
API_PREFIX=api
# CORS origins for the two frontends
CORS_ORIGINS=http://localhost:5273,http://localhost:5274

# ── Database (PostgreSQL + PostGIS) ──
DB_HOST=localhost
DB_PORT=5436
DB_USER=sherpa
DB_PASSWORD=sherpa
DB_NAME=sherpa_lm

# ── Redis (BullMQ queues + pub/sub) ──
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth ──
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# ── Notifications (pluggable; stub by default — no external service needed) ──
# console = log to stdout. Switch to fcm / whatsapp to use real adapters.
NOTIFY_PUSH_PROVIDER=console
NOTIFY_WHATSAPP_PROVIDER=console
# FCM (only used when NOTIFY_PUSH_PROVIDER=fcm)
FCM_SERVER_KEY=
# WhatsApp via Evolution API (only used when NOTIFY_WHATSAPP_PROVIDER=whatsapp)
EVOLUTION_API_URL=http://159.65.224.135:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=sherpa

# ── File storage (local disk stub by default; s3 swappable) ──
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# ── Maps (frontend; schematic canvas used when empty) ──
VITE_MAPBOX_TOKEN=

# ── Public base URL (consignee tracking links) ──
PUBLIC_BASE_URL=http://localhost:5273
