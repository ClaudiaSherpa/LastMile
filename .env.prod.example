# Copy to .env.prod on the Droplet and fill in real values (never commit .env.prod).
# Database (internal to the compose network)
DB_USER=pasarex
DB_PASSWORD=change-me-strong-db-password
DB_NAME=pasarex_lm

# Auth — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Public origin (droplet IP or domain)
PUBLIC_BASE_URL=http://YOUR_DROPLET_IP
CORS_ORIGINS=http://YOUR_DROPLET_IP

# GPS live-map simulation
TRACKING_SIMULATE=on

# OCR (optional — blank disables auto-fill)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# WhatsApp via Evolution (optional)
EVOLUTION_API_URL=http://159.65.224.135:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=pasarex
EVOLUTION_WEBHOOK_TOKEN=change-me-hook
